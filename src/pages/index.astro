---
import { getCollection } from 'astro:content';
import { categorias, getArticleUrl } from '../lib/blog';

const year = new Date().getFullYear();

const artigos = (await getCollection('artigos', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const artigoDestaque = artigos[0];

const artigosRecentes = artigos
	.filter((artigo) => artigo.id !== artigoDestaque?.id)
	.slice(0, 4);

const formatarData = (data: Date) =>
	data.toLocaleDateString('pt-BR', {
		day: '2-digit',
		month: 'short',
		year: 'numeric',
		timeZone: 'UTC',
	}).toUpperCase();
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Códigos Filosóficos: inteligência artificial, defesa cibernética, filosofia e soberania digital."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Códigos Filosóficos</title>
	</head>

	<body>
		<header class="site-header">
			<a class="brand" href="/">
				<span>&lt;/&gt;</span>
				Códigos Filosóficos
			</a>

			<nav>
				<a href="/artigos/">Artigos</a>
				<a href="/defesa-cibernetica/">Defesa Cibernética</a>
				<a href="/inteligencia-artificial/">IA</a>
				<a href="#categorias">Categorias</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div>
					<p class="eyebrow">TECNOLOGIA • FILOSOFIA • CIBERSEGURANÇA</p>

					<h1>
						Pensar o mundo.<br />
						Entender os sistemas.<br />
						Escrever o código.
					</h1>

					<p class="hero-text">
						Uma base de conhecimento sobre inteligência artificial, defesa
						cibernética, filosofia, soberania digital e laboratórios práticos.
					</p>

					<div class="hero-actions">
						<a class="primary" href="/artigos/">Ver artigos</a>
						<a class="secondary" href="/defesa-cibernetica/honeypot-cowrie/">
							Ler análise do Cowrie
						</a>
					</div>
				</div>

				<div class="terminal-card" aria-label="Terminal decorativo">
					<div class="terminal-bar">
						<span></span>
						<span></span>
						<span></span>
					</div>

					<pre><code>matheus@codigos:~$ whoami
estudante, pesquisador, construtor

matheus@codigos:~$ cat manifesto.txt
Conhecimento técnico é uma forma de autonomia.

matheus@codigos:~$ ls categorias/
ia  cyber  filosofia  soberania  labs</code></pre>
				</div>
			</section>

			<section class="section" id="artigos">
				<div class="section-header">
					<p class="eyebrow">PUBLICAÇÕES</p>
					<h2>Últimos artigos</h2>
					<a href="/artigos/">Ver todos →</a>
				</div>

				{
					artigoDestaque ? (
						<div class="featured-grid">
							<article class="featured-card">
								<div class="meta">
									<span>{artigoDestaque.data.category}</span>
									<time datetime={artigoDestaque.data.pubDate.toISOString()}>
										{formatarData(artigoDestaque.data.pubDate)}
									</time>
								</div>

								<h3>
									<a href={getArticleUrl(artigoDestaque)}>
										{artigoDestaque.data.title}
									</a>
								</h3>

								<p>{artigoDestaque.data.description}</p>

								<div class="tags">
									{artigoDestaque.data.tags.map((tag) => <span>{tag}</span>)}
								</div>

								<a class="read-more" href={getArticleUrl(artigoDestaque)}>
									Ler artigo →
								</a>
							</article>

							<div class="recent-list">
								{
									artigosRecentes.length > 0 ? (
										artigosRecentes.map((artigo) => (
											<article class="small-card">
												<div class="meta">
													<span>{artigo.data.category}</span>
													<time datetime={artigo.data.pubDate.toISOString()}>
														{formatarData(artigo.data.pubDate)}
													</time>
												</div>

												<h3>
													<a href={getArticleUrl(artigo)}>
														{artigo.data.title}
													</a>
												</h3>

												<p>{artigo.data.description}</p>

												<a class="read-more" href={getArticleUrl(artigo)}>
													Ler →
												</a>
											</article>
										))
									) : (
										<div class="empty-card">
											<p>
												Novos artigos aparecerão aqui conforme forem publicados.
											</p>
										</div>
									)
								}
							</div>
						</div>
					) : (
						<div class="empty-card">
							<p>Nenhum artigo publicado ainda.</p>
						</div>
					)
				}
			</section>

			<section class="section" id="categorias">
				<div class="section-header">
					<p class="eyebrow">ORGANIZAÇÃO</p>
					<h2>Categorias do blog</h2>
				</div>

				<div class="categories-grid">
					{
						categorias.map((categoria) => (
							<a class="category-card" href={`/${categoria.slug}/`}>
								<span>{categoria.title}</span>
								<p>{categoria.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="section manifesto" id="sobre">
				<p class="eyebrow">MANIFESTO</p>

				<h2>
					O blog não é apenas um lugar para postar textos. É um laboratório
					público de pensamento técnico.
				</h2>

				<p>
					A proposta do Códigos Filosóficos é documentar estudos, projetos,
					laboratórios e reflexões sobre tecnologia, segurança, inteligência
					artificial e soberania digital.
				</p>
			</section>
		</main>

		<footer>
			<p>© {year} Códigos Filosóficos</p>
			<a href="mailto:matheusgagliotti@proton.me">
				matheusgagliotti@proton.me
			</a>
		</footer>
	</body>
</html>

<style>
	:root {
		--background: #080b0f;
		--surface: #0f141a;
		--surface-light: #151c24;
		--text: #f3f5f7;
		--muted: #929ca8;
		--accent: #5cffb0;
		--border: rgba(255, 255, 255, 0.1);
		--max-width: 1180px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		min-height: 100vh;
		background:
			radial-gradient(circle at 80% 0%, rgba(92, 255, 176, 0.1), transparent 30rem),
			radial-gradient(circle at 0% 20%, rgba(70, 110, 255, 0.08), transparent 28rem),
			var(--background);
		color: var(--text);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header,
	main,
	footer {
		width: min(calc(100% - 40px), var(--max-width));
		margin-inline: auto;
	}

	.site-header {
		padding: 28px 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		font-weight: 700;
	}

	.brand span,
	.eyebrow,
	.read-more,
	.section-header a {
		color: var(--accent);
	}

	nav {
		display: flex;
		gap: 24px;
	}

	nav a {
		color: var(--muted);
		font-size: 0.92rem;
	}

	nav a:hover {
		color: var(--accent);
	}

	.hero {
		min-height: 76vh;
		padding: 95px 0 80px;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
		gap: 55px;
		align-items: center;
	}

	.eyebrow {
		margin-bottom: 18px;
		font-family: monospace;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	h1 {
		font-size: clamp(3.4rem, 8vw, 7rem);
		line-height: 0.92;
		letter-spacing: -0.075em;
	}

	.hero-text {
		max-width: 700px;
		margin-top: 32px;
		color: var(--muted);
		font-size: 1.13rem;
	}

	.hero-actions {
		margin-top: 36px;
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.primary,
	.secondary {
		padding: 13px 18px;
		border-radius: 6px;
		font-weight: 700;
	}

	.primary {
		background: var(--accent);
		color: #05100b;
	}

	.secondary {
		border: 1px solid var(--border);
		color: var(--text);
	}

	.secondary:hover {
		border-color: rgba(92, 255, 176, 0.45);
	}

	.terminal-card {
		border: 1px solid var(--border);
		border-radius: 12px;
		background: rgba(15, 20, 26, 0.78);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
		overflow: hidden;
	}

	.terminal-bar {
		padding: 14px 16px;
		display: flex;
		gap: 8px;
		border-bottom: 1px solid var(--border);
		background: var(--surface-light);
	}

	.terminal-bar span {
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background: var(--muted);
		opacity: 0.45;
	}

	pre {
		overflow-x: auto;
		padding: 24px;
		color: #dce4ea;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 0.85rem;
		line-height: 1.75;
	}

	.section {
		padding: 90px 0;
		border-top: 1px solid var(--border);
	}

	.section-header {
		margin-bottom: 35px;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
	}

	h2 {
		font-size: clamp(2.4rem, 5vw, 4.7rem);
		line-height: 0.98;
		letter-spacing: -0.06em;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: 18px;
	}

	.featured-card,
	.small-card,
	.empty-card,
	.category-card {
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
	}

	.featured-card {
		padding: 40px;
	}

	.small-card,
	.empty-card,
	.category-card {
		padding: 28px;
	}

	.recent-list {
		display: grid;
		gap: 18px;
	}

	.meta {
		margin-bottom: 18px;
		display: flex;
		justify-content: space-between;
		gap: 18px;
		color: var(--muted);
		font-family: monospace;
		font-size: 0.72rem;
		text-transform: uppercase;
	}

	.meta span {
		color: var(--accent);
	}

	h3 {
		font-size: clamp(1.5rem, 3vw, 2.65rem);
		line-height: 1.08;
		letter-spacing: -0.04em;
	}

	.small-card h3 {
		font-size: 1.45rem;
	}

	h3 a:hover {
		color: var(--accent);
	}

	.featured-card p,
	.small-card p,
	.empty-card p,
	.category-card p,
	.manifesto p {
		margin-top: 18px;
		color: var(--muted);
	}

	.tags {
		margin-top: 24px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tags span {
		padding: 5px 9px;
		border-radius: 4px;
		background: var(--surface-light);
		color: var(--muted);
		font-family: monospace;
		font-size: 0.7rem;
	}

	.read-more {
		display: inline-block;
		margin-top: 26px;
		font-weight: 700;
	}

	.categories-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.category-card {
		min-height: 190px;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.category-card:hover {
		transform: translateY(-3px);
		border-color: rgba(92, 255, 176, 0.45);
	}

	.category-card span {
		color: var(--text);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.manifesto {
		max-width: 900px;
	}

	.manifesto h2 {
		font-size: clamp(2.2rem, 5vw, 4.5rem);
	}

	.manifesto p {
		max-width: 760px;
		font-size: 1.12rem;
	}

	footer {
		padding: 35px 0 50px;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.78rem;
	}

	footer a:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.hero,
		.featured-grid,
		.categories-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 650px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 22px;
		}

		nav {
			flex-wrap: wrap;
			gap: 16px;
		}

		.hero {
			padding-top: 70px;
		}

		.section-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.featured-card,
		.small-card,
		.empty-card,
		.category-card {
			padding: 24px;
		}

		.meta,
		footer {
			flex-direction: column;
		}

		.meta {
			gap: 5px;
		}
	}

/* AJUSTE VISUAL DO MANIFESTO E CATEGORIAS */
.manifesto {
	max-width: 980px;
	padding-top: 120px;
	padding-bottom: 110px;
}

.manifesto .eyebrow {
	margin-bottom: 34px;
}

.manifesto h2 {
	max-width: 920px;
	font-size: clamp(2.1rem, 4.1vw, 3.9rem);
	line-height: 1.12;
	letter-spacing: -0.045em;
	text-wrap: balance;
}

.manifesto p {
	max-width: 760px;
	margin-top: 38px;
	color: var(--muted);
	font-size: 1.08rem;
	line-height: 1.85;
}

.category-card {
	padding: 34px;
}

.category-card span {
	display: block;
	margin-bottom: 22px;
	line-height: 1.25;
}

.category-card p {
	margin-top: 0;
	line-height: 1.75;
}

.categories-grid {
	gap: 22px;
}

</style>
